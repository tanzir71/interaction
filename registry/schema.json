{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intrx.vercel.app/registry/schema.json",
  "title": "INTRX component",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "group",
    "trigger",
    "tier",
    "stage",
    "a11y",
    "files",
    "parts",
    "prompt",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string"
    },
    "thumb": {
      "enum": [
        "full",
        "hero"
      ]
    },
    "thumbDesignSize": {
      "description": "Optional declared hero plane; valid only with thumb: hero.",
      "oneOf": [
        {
          "enum": [
            "sm",
            "md",
            "lg"
          ]
        },
        {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "trigger": {
      "enum": [
        "hover",
        "press",
        "drag",
        "scroll",
        "type",
        "ambient"
      ]
    },
    "tier": {
      "enum": [
        "free",
        "pro"
      ]
    },
    "stage": {
      "type": "object",
      "required": [
        "theme",
        "overflow",
        "designSize"
      ]
    },
    "a11y": {
      "type": "object"
    },
    "files": {
      "type": "array"
    },
    "parts": {
      "type": [
        "object",
        "null"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 300
    },
    "version": {
      "type": "string"
    },
    "photoCredits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "asset",
          "photoId",
          "imageId",
          "photographer",
          "url",
          "license",
          "licenseUrl",
          "verifiedAt"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "asset": {
            "type": "string"
          },
          "photoId": {
            "type": "string"
          },
          "imageId": {
            "type": "string"
          },
          "photographer": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "license": {
            "const": "Unsplash License"
          },
          "licenseUrl": {
            "const": "https://unsplash.com/license"
          },
          "verifiedAt": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "fullAssetRefs": {
      "description": "Local 1600px detail-preview assets. Portable exports embed the 800px assetRefs variants.",
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^assets/images/[\\w-]+\\.webp$"
      }
    },
    "controls": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "action",
          "label"
        ],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "ariaLabel": {
            "type": "string",
            "minLength": 1,
            "description": "Optional fixed accessible identity for a toggle with changing visible captions. Include its complete visible label aliases."
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "thumbDesignSize"
        ]
      },
      "then": {
        "properties": {
          "thumb": {
            "const": "hero"
          }
        },
        "required": [
          "thumb"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "tier": {
            "const": "pro"
          }
        }
      },
      "then": {
        "properties": {
          "files": {
            "maxItems": 0
          },
          "parts": {
            "type": "null"
          },
          "locked": {
            "const": true
          }
        },
        "required": [
          "locked"
        ]
      }
    }
  ]
}
