{
  "file": "js/demos.drams.sliders.js",
  "id": "drams-034",
  "title": "Volume Hidden Track",
  "rootClass": "d-drams-034",
  "html": "<div class=\"d-drams-034\"><div class=\"dial hidden\" role=\"slider\" tabindex=\"0\" aria-label=\"Volume\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"0\" data-initial=\"0\"><div class=\"knob\"><i class=\"rotor\"></i></div></div></div>",
  "css": ".d-drams-034{width:100%;height:320px;display:grid;place-items:center;position:relative;background:#fff;color:#555;font:400 12px \"Inter\",system-ui,sans-serif;overflow:hidden}.d-drams-034 *{box-sizing:border-box}.d-drams-034 button,.d-drams-034 input{font:inherit}.d-drams-034 [role=slider],.d-drams-034 button{touch-action:none;-webkit-tap-highlight-color:transparent}.d-drams-034 :is(button,input,[role=slider]):focus-visible{outline:2px solid #bd5b2a;outline-offset:7px}.d-drams-034 .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}@media(prefers-reduced-motion:reduce){.d-drams-034 *{animation:none!important;transition:none!important}}.d-drams-034 .dial{width:114px;height:114px;position:relative;border-radius:50%;cursor:grab;display:grid;place-items:center}.d-drams-034 .dial[data-dragging=true]{cursor:grabbing}.d-drams-034 .bezel{position:absolute;inset:0;border-radius:50%;background:linear-gradient(135deg,#f7f7f7 12%,#ededed 60%,#e4e4e4);box-shadow:inset 0 1px 1px #fff,1px 2px 3px #00000008}.d-drams-034 .knob{position:absolute;width:76px;height:76px;border-radius:50%;background:linear-gradient(145deg,#fafafa,#f0f0f0 50%,#e7e7e7);box-shadow:inset 1px 1px 2px #fff,inset -1px -1px 1px #dadada,2px 3px 4px #00000010,5px 9px 10px #00000020}.d-drams-034 .rotor{position:absolute;inset:0;border-radius:50%;transform:rotate(var(--angle,-135deg));transition:transform .1s linear}.d-drams-034 .dial[data-dragging=true] .rotor{transition:none}.d-drams-034 .rotor:after{content:'';position:absolute;width:5px;height:5px;left:calc(50% - 2.5px);top:8px;border-radius:50%;background:#f26b23;box-shadow:inset 0 1px 1px #e4581940}.d-drams-034 .arc{position:absolute;inset:0;width:100%;height:100%;overflow:visible}.d-drams-034 .arc path{fill:none;stroke:#e3e3e3;stroke-width:3;stroke-linecap:round}.d-drams-034 .tick{position:absolute;inset:0;transform:rotate(var(--tick));pointer-events:none}.d-drams-034 .tick:after{content:'';position:absolute;top:0;left:calc(50% - 1px);height:9px;width:2px;border-radius:2px;background:#e7e7e7}.d-drams-034 .hidden{width:80px;height:80px}.d-drams-034 .hidden .knob{width:64px;height:64px}.d-drams-034 .hidden .rotor:after{width:3px;height:3px;left:calc(50% - 1.5px);top:7px}",
  "js": "const control=root.querySelector('[role=slider]');let value=Number(control.dataset.initial||0),startY=0,startX=0,startValue=0,drag=false;function set(next){value=Math.max(0,Math.min(100,next));control.style.setProperty('--angle',(-135+value*2.7)+'deg');control.setAttribute('aria-valuenow',String(Math.round(value)));control.setAttribute('aria-valuetext',Math.round(value)+' percent');root.dataset.value=String(Math.round(value))}control.addEventListener('pointerdown',event=>{if(event.button!==0)return;drag=true;startX=event.clientX;startY=event.clientY;startValue=value;control.setPointerCapture(event.pointerId);control.focus({preventScroll:true});control.dataset.dragging='true'});control.addEventListener('pointermove',event=>{if(drag)set(startValue+(startY-event.clientY)+(event.clientX-startX)*.35)});function end(){drag=false;control.dataset.dragging='false'}control.addEventListener('pointerup',end);control.addEventListener('pointercancel',end);control.addEventListener('lostpointercapture',end);control.addEventListener('keydown',event=>{let next=value;if(event.key==='Home')next=0;else if(event.key==='End')next=100;else if(['ArrowUp','ArrowRight'].includes(event.key))next+=5;else if(['ArrowDown','ArrowLeft'].includes(event.key))next-=5;else if(event.key==='PageUp')next+=20;else if(event.key==='PageDown')next-=20;else return;event.preventDefault();set(next)});set(value);",
  "prompt": "Build a self-contained, accessible native HTML/CSS/JavaScript interpretation of Volume Hidden Track from https://drams.framer.website/drams/034. Credit DRAMS by 1042 Studio (@mrblackstudio and @karimeshrimp). A compact white rotary knob with a single orange indicator and no visible track. Use a white 320px stage, soft neutral contact shadows, subtle physical edge highlights and orange details. drag upward to increase volume, downward to decrease, or use the arrow keys. Preserve pointer and keyboard operation, reduced-motion support and the distinct geometry of this component. No hosted Framer embed or external runtime dependency.",
  "source": {
    "name": "DRAMS · 1042 Studio / Volume Hidden Track",
    "url": "https://drams.framer.website/drams/034"
  },
