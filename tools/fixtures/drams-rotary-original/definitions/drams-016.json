  "html": "<div class=\"d-drams-016\"><div class=\"plus-frame\"><span class=\"mark top\">0</span><span class=\"mark lt\">6</span><span class=\"mark rt\">6</span><span class=\"mark lb\">12</span><span class=\"mark rb\">12</span><button class=\"minus\" data-delta=\"-1\" aria-label=\"Decrease\">−</button><button class=\"plus\" data-delta=\"1\" aria-label=\"Increase\">+</button><div class=\"control\" role=\"slider\" tabindex=\"0\" aria-label=\"Plus minus dial\" aria-valuemin=\"-12\" aria-valuemax=\"12\"><div class=\"disc white-disc\"><i></i></div></div></div><span class=\"sr\" aria-live=\"polite\"></span></div>",
  "css": ".d-drams-016{position:relative;display:grid;place-items:center;width:100%;height:320px;overflow:hidden;box-sizing:border-box;background:#fff;color:#515151;font:400 12px/1.3 Inter,system-ui,sans-serif;isolation:isolate;font-variant-numeric:tabular-nums} .d-drams-016 *{box-sizing:border-box;font-family:inherit;font-variant-numeric:tabular-nums} .d-drams-016 button{font:inherit;cursor:pointer} .d-drams-016 .control{position:relative;outline:none;touch-action:none;user-select:none} .d-drams-016 .control:focus-visible{outline:2px solid #fa651f66;outline-offset:10px;border-radius:50%} .d-drams-016 .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)} .d-drams-016 .disc{position:absolute;border-radius:50%;inset:0;will-change:transform} .d-drams-016 .white-disc{background:linear-gradient(145deg,#f8f8f8,#e6e6e6);box-shadow:inset 1px 2px 3px #fff,inset -1px -2px 3px #d9d9d9,9px 12px 15px #00000026,2px 3px 3px #0000001a} .d-drams-016 .orange-dot{position:absolute;width:6px;height:6px;border-radius:50%;background:#fb641f} .d-drams-016 .mark{position:absolute;left:50%;top:50%;font-size:13px;line-height:1;color:#555;transform:translate(-50%,-50%)} .d-drams-016 .sphere{border-radius:50%;background:radial-gradient(circle at 31% 23%,#fff 0%,#f5f5f5 17%,#dfdfdf 47%,#a4a4a4 93%);box-shadow:inset 1px 2px 3px #fff7,0 9px 12px #00000016} .d-drams-016 .sphere:after{content:'';position:absolute;left:45%;top:45%;width:6px;height:6px;border-radius:50%;background:#ff651f} .d-drams-016 button:focus-visible{outline:2px solid #fa651f66;outline-offset:5px}\n.d-drams-016 .plus-frame{width:164px;height:166px;position:relative}.d-drams-016 .control{width:92px;height:92px;position:absolute;left:36px;top:37px}.d-drams-016 .disc:before{content:'';position:absolute;left:36px;top:-10px;width:20px;height:20px;border-radius:4px;transform:rotate(45deg);background:linear-gradient(135deg,#fafafa,#ececec);z-index:-1;box-shadow:1px 0 2px #0001}.d-drams-016 .top{top:13px}.d-drams-016 .lt{left:20px;top:51px;transform:rotate(20deg)}.d-drams-016 .rt{left:140px;top:51px;transform:rotate(-20deg)}.d-drams-016 .lb{left:17px;top:115px}.d-drams-016 .rb{left:147px;top:115px}.d-drams-016 .plus,.d-drams-016 .minus{position:absolute;bottom:10px;border:0;background:none;color:#666;font-size:18px;width:30px;height:26px;padding:0}.d-drams-016 .minus{left:45px}.d-drams-016 .plus{right:45px}",
  "js": "const control=root.querySelector('.control'),disc=root.querySelector('.disc'),status=root.querySelector('.sr');const controller=new AbortController(),opts={signal:controller.signal};let value=0,down=false,startY=0,startX=0,startValue=value;const min=-12,max=12,step=1;function set(v,source){value=Math.max(min,Math.min(max,Math.round(v/step)*step));const angle=value*10;disc.style.transform='rotate('+angle+'deg)';control.setAttribute('aria-valuenow',value);control.setAttribute('aria-valuetext',value+'');root.dataset.value=String(value);root.dataset.angle=String(angle);root.dataset.source=source;status.textContent=\"Plus Minus Knob\"+': '+value+'';root.querySelectorAll('[data-tick]').forEach(t=>t.setAttribute('data-active',Number(t.dataset.tick)===value?'true':'false'))}control.addEventListener('pointerdown',e=>{if(e.button!==0)return;down=true;startX=e.clientX;startY=e.clientY;startValue=value;control.setPointerCapture(e.pointerId);control.focus({preventScroll:true});root.dataset.dragging='true'},opts);control.addEventListener('pointermove',e=>{if(down)set(startValue+((e.clientX-startX)-(e.clientY-startY))*(max-min)/150,'drag')},opts);function release(e){if(!down)return;down=false;root.dataset.dragging='false';if(control.hasPointerCapture(e.pointerId))control.releasePointerCapture(e.pointerId)}control.addEventListener('pointerup',release,opts);control.addEventListener('pointercancel',release,opts);control.addEventListener('keydown',e=>{if(['ArrowUp','ArrowRight','ArrowDown','ArrowLeft','Home','End',' '].includes(e.key)){e.preventDefault();set(e.key==='Home'?min:e.key==='End'?max:e.key===' '?value>=max?min:value+step:value+(['ArrowUp','ArrowRight'].includes(e.key)?step:-step),'keyboard')}},opts);root.querySelectorAll('[data-value]').forEach(b=>b.addEventListener('click',()=>set(Number(b.dataset.value),'select'),opts));root.querySelectorAll('[data-delta]').forEach(b=>b.addEventListener('click',()=>set(value+Number(b.dataset.delta),'button'),opts));set(value,'initial');return()=>controller.abort();",
  "prompt": "Recreate the Plus Minus Knob composition from https://drams.framer.website/drams/016 as standalone HTML, CSS and JavaScript in a native 300 by 320 white stage. Preserve its proportions, gentle physical materials, interaction states and keyboard access. Use locally bundled Inter for labels and tabular numerical values. Drag the control, use arrow keys, Home or End.",
